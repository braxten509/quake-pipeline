<mxfile host="drawio">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="420">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="usgs" value="&lt;b&gt;USGS Earthquake API&lt;/b&gt;&lt;br&gt;(FDSN event service)&lt;br&gt;worldwide, updates every minute" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="20" y="140" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pc" value="&lt;b&gt;Your PC: one-time seed&lt;/b&gt;&lt;br&gt;download_history.py&lt;br&gt;&amp;#8594; data/raw (61 monthly CSVs)&lt;br&gt;&amp;#8594; load_history.py&lt;br&gt;&lt;i&gt;744,087 quakes, Nov 2021 &amp;#8211; now&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="400" y="20" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="gha" value="&lt;b&gt;Your PC: cron job every 15 min&lt;/b&gt;&lt;br&gt;systemd timer &amp;#8594; ingest_live.py&lt;br&gt;key-pair login,&lt;br&gt;catches up after sleep" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;">
          <mxGeometry x="400" y="240" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sf" value="&lt;b&gt;Snowflake&lt;/b&gt; (trial)&lt;br&gt;warehouse PIPELINE_WH&lt;br&gt;X-Small, auto-suspend 60 s, 30-credit cap&lt;br&gt;&lt;br&gt;&lt;b&gt;QUAKES.CORE.EARTHQUAKES&lt;/b&gt;&lt;br&gt;&lt;b&gt;QUAKES.CORE.INGEST_RUNS&lt;/b&gt;&lt;br&gt;&lt;br&gt;MERGE on USGS ID = no duplicates" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e1d5e7;strokeColor=#9673a6;">
          <mxGeometry x="780" y="90" width="290" height="220" as="geometry" />
